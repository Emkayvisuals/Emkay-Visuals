rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/content {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'emkayvisuals@gmail.com';
    }
    match /briefs/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'emkayvisuals@gmail.com';
    }
    match /projectBriefs/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'emkayvisuals@gmail.com';
    }
    match /analytics/{document} {
      allow read: if request.auth != null && request.auth.token.email == 'emkayvisuals@gmail.com';
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.token.email == 'emkayvisuals@gmail.com';
    }
  }
}
